<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="xmobot">

    <!-- Define parameters with default values -->
    <xacro:arg name="robot_length" default="0.5"/>
    <xacro:arg name="robot_width" default="0.4"/>
    <xacro:arg name="robot_height" default="0.1"/>
    <xacro:arg name="wheel_radius" default="0.08"/>
    <xacro:arg name="wheel_width" default="0.05"/>
    <xacro:arg name="wheel_separation_x" default="0.5"/>
    <xacro:arg name="wheel_separation_y" default="0.4"/>
    <xacro:arg name="drive_type" default="4wis"/>
    <xacro:arg name="use_mesh" default="false"/>
    <xacro:arg name="use_arms" default="true"/>
    <xacro:arg name="arm_count" default="2"/>
    <xacro:arg name="arm_mount_x" default="auto"/>
    <xacro:arg name="arm_spacing" default="auto"/>

    <xacro:arg name="control_config" default=""/>

    <!-- 全局参数 -->
    <xacro:property name="use_mesh" value="$(arg use_mesh)"/>
    <xacro:property name="use_arms" value="$(arg use_arms)"/>
    <xacro:property name="drive_type" value="$(arg drive_type)"/>
    <xacro:property name="robot_length" value="$(arg robot_length)" />
    <xacro:property name="robot_width" value="$(arg robot_width)" />
    <xacro:property name="robot_height" value="$(arg robot_height)" />
    <xacro:property name="wheel_radius" value="$(arg wheel_radius)"/>
    <xacro:property name="wheel_width" value="$(arg wheel_width)" />
    <xacro:property name="wheel_separation_x" value="$(arg wheel_separation_x)" />
    <xacro:property name="wheel_separation_y" value="$(arg wheel_separation_y)" />

    <!-- The steering bearing (also the fixed mount spacing) sits below the body. -->
    <xacro:property name="mount_height" value="0.03"/>
    <xacro:property name="deck_surface_z" value="${robot_height / 2}"/>
    <xacro:property name="body_center_z" value="${2 * wheel_radius + mount_height + deck_surface_z}"/>
    <xacro:property name="requested_arms" value="$(arg arm_count)"/>
    <xacro:property name="installed_arms" value="${(0, 1, 2).index(requested_arms) if use_arms else 0}"/>

    <!-- Positions are in the base frame. Keep the 50 mm arm feet on the deck
         and leave 2 mm between the LiDAR housing and each arm footprint. -->
    <xacro:property name="requested_arm_x" value="$(arg arm_mount_x)"/>
    <xacro:property name="requested_spacing" value="$(arg arm_spacing)"/>
    <xacro:property name="edge_limit" value="${robot_length / 2 - 0.05}"/>
    <xacro:property name="single_x" value="${max(-edge_limit, min(-0.102, -robot_length / 4 if requested_arm_x == 'auto' else requested_arm_x))}"/>
    <xacro:property name="dual_y" value="${min(robot_width / 2 - 0.05, max(0.051, robot_width * 0.3 if requested_spacing == 'auto' else requested_spacing / 2))}"/>
    <xacro:property name="dual_min_x" value="${sqrt(max(0, 0.102 ** 2 - dual_y ** 2))}"/>
    <xacro:property name="dual_x" value="${min(edge_limit, max(dual_min_x, robot_length / 4 if requested_arm_x == 'auto' else requested_arm_x))}"/>

    <xacro:property name="M_PI" value="3.1415926535897931" />
    <xacro:property name="M_PI_2" value="1.570796327" />
    <xacro:property name="DEG_TO_RAD" value="0.017453293" />

    <!-- Import Xacro -->
    <xacro:include filename="xmobot_inertial.xacro"/>

    <xacro:include filename="xmobot_base.xacro"/>
    <xacro:include filename="xmobot_arm.xacro"/>
    <xacro:include filename="xmobot_arm_gazebo.xacro"/>
    <xacro:macro name="mounted_arm" params="prefix x y">
        <xacro:xmobot_arm prefix="${prefix}" parent_link="base_link"
                          arm_offset_x="${x}" arm_offset_y="${y}" arm_offset_z="${deck_surface_z}"/>
        <xacro:gazebo_arm_plugins prefix="${prefix}"/>
    </xacro:macro>
    <xacro:if value="${installed_arms == 1}">
        <xacro:mounted_arm prefix="left_" x="${single_x}" y="0"/>
    </xacro:if>
    <xacro:if value="${installed_arms == 2}">
        <xacro:mounted_arm prefix="left_" x="${dual_x}" y="${dual_y}"/>
        <xacro:mounted_arm prefix="right_" x="${dual_x}" y="${-dual_y}"/>
    </xacro:if>

    <xacro:include filename="xmobot_base_gazebo.xacro"/>
    <xacro:gazebo_base_plugins drive_type="${drive_type}"/>

</robot>
