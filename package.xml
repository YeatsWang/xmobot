<?xml version="1.0"?>
<package format="3">
  <name>xmobot</name>
  <version>0.1.0</version>
  <description>
    Xmobot is a flexible and modular mobile robot platform designed for SLAM, path planning,
    and end-to-end navigation benchmarking across diverse drive types: differential,
    Ackermann, Mecanum (omnidirectional), and four-wheel independent steering with driving.
  </description>

  <maintainer email="wangyizhi@csu.edu.cn">Yeats Wang</maintainer>
  <author email="wangyizhi@csu.edu.cn">Yeats Wang</author>
  <license>MIT</license>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>gazebo_ros2_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
